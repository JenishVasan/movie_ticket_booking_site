<%- include('../partials/header.ejs', { pageName: "CINEVERSE | PROFILE", CustomCss: "profile.css" }) %>

<div class="profile-container">
    <div class="profile-header">
        <h1 class="profile-title">My Tickets</h1>
    </div>

    <div class="tickets-grid">
        <% if (typeof tickets !== 'undefined' && tickets.length > 0) { %>
            <% tickets.forEach(ticket => { %>
                <div class="ticket-card" id="ticket-<%= ticket._id %>">
                    <div class="ticket-header">
                        <h2 class="movie-title"><%= ticket.movie.title %></h2>
                        <span class="ticket-status status-<%= ticket.status.toLowerCase() %>" id="status-<%= ticket._id %>">
                            <%= ticket.status %>
                        </span>
                    </div>

                    <div class="ticket-details">
                        <div class="detail-row">
                            <span class="detail-label">Cinema</span>
                            <span class="detail-value"><%= ticket.show.screenId.theatreId.name %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Screen</span>
                            <span class="detail-value"><%= ticket.show.screenId.name %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Date & Time</span>
                            <span class="detail-value">
                                <%= new Date(ticket.show.startTime).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Seats</span>
                            <span class="detail-value">
                                <% ticket.seats.forEach(seat => { %>
                                    <span class="seats-badge"><%= seat.seatNumber %></span>
                                <% }) %>
                            </span>
                        </div>
                    </div>

                    <div class="ticket-footer">
                        <div class="total-amount">
                            Total: $<%= ticket.totalAmount ? ticket.totalAmount.toFixed(2) : ticket.seats.reduce((acc, curr) => acc + curr.price, 0).toFixed(2) %>
                        </div>
                        
                        <% 
                            const now = new Date();
                            const showTime = new Date(ticket.show.startTime);
                            const hoursDiff = (showTime - now) / (1000 * 60 * 60);
                        %>
                        
                        <% if (ticket.status !== 'CANCELLED' && hoursDiff > 24) { %>
                            <button class="btn-cancel" onclick="cancelTicket('<%= ticket._id %>')">Cancel Ticket</button>
                        <% } else if (ticket.status !== 'CANCELLED' && hoursDiff <= 24 && hoursDiff > 0) { %>
                            <span style="color:#888; font-size:0.8rem;">Not cancellable (<24h)</span>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="no-tickets">
                You have no booked tickets yet. <br><br>
                <a href="/index.html#trending" style="color:#fff; text-decoration:underline;">Browse Movies</a>
            </div>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function cancelTicket(ticketId) {
        const result = await Swal.fire({
            title: 'Cancel Ticket?',
            text: "This action cannot be undone. Are you sure?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ff4444',
            cancelButtonColor: '#444',
            confirmButtonText: 'Yes, cancel it!'
        });

        if (result.isConfirmed) {
            try {
                const response = await fetch(`/cancel-ticket/${ticketId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    Swal.fire('Cancelled!', 'Your ticket has been cancelled.', 'success').then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Error', data.error || 'Failed to cancel ticket', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'An unexpected error occurred', 'error');
            }
        }
    }
</script>

<%- include('../partials/footer.ejs', { customJs: null }) %>
